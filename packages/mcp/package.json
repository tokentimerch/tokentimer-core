{
  "name": "@tokentimer/mcp",
  "version": "0.18.0",
  "private": true,
  "description": "TokenTimer MCP adapter: a stateless stdio server that exposes the operator read API to MCP clients",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.13.0",
  "type": "commonjs",
  "main": "src/index.js",
  "bin": {
    "tokentimer-mcp": "bin/tokentimer-mcp.js"
  },
  "scripts": {
    "start": "node bin/tokentimer-mcp.js",
    "test": "node --test --test-force-exit src/**/*.test.js",
    "test:e2e": "node --test --test-force-exit e2e/**/*.e2e.test.js",
    "lint": "eslint ."
  },
  "files": [
    "bin/*.js",
    "src",
    "!src/**/*.test.js"
  ],
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@tokentimer/contracts": "workspace:*",
    "@tokentimer/log-scrub": "workspace:*",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "eslint": "9.39.2"
  }
}
