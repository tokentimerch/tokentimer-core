    },
    "deploymentDestination": {
      "$ref": "https://tokentimer.io/contracts/certops/deployment-destination.schema.json#/definitions/scope"
    },
    "signature": {
      "$ref": "https://tokentimer.io/contracts/certops/signed-dispatch-wire-v1.schema.json#/properties/signature"
    }
  }
}
