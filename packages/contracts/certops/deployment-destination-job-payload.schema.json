{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tokentimer.io/contracts/certops/deployment-destination-job-payload.schema.json",
  "title": "CertOps Deployment Destination Validation Job",
  "description": "Read-only validation through the native signed agent path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
