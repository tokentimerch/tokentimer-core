    "jobId",
    "workspaceId",
    "agentId",
    "requestedAt",
    "issuedAt",
    "expiresAt",
    "nonce",
    "signingKeyId",
    "claimId",
    "attemptId",
    "leaseExpiresAt",
    "action",
