{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tokentimer.io/contracts/certops/deployment-destination.schema.json",
  "title": "CertOps Deployment Destination v1",
  "description": "Closed scopes, validation evidence and approved execution authority for locally provisioned certificate deployment destinations. References are opaque identifiers.",
  "definitions": {
    "opaqueRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "zoneRef",
        "destinationKind",
        "destinationRef",
        "materialRef",
        "materialRevision",
        "fingerprintSha256"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "zoneRef": {
          "$ref": "#/definitions/opaqueRef"
        },
        "destinationKind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "destinationRef": {
          "$ref": "#/definitions/opaqueRef"
        },
        "materialRef": {
          "$ref": "#/definitions/opaqueRef"
        },
        "materialRevision": {
          "$ref": "#/definitions/opaqueRef"
        },
        "fingerprintSha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configurationSha256",
        "trustSha256",
        "observedStateSha256",
        "planSha256",
        "affectedServiceRefs",
        "permittedEffects"
      ],
      "properties": {
        "configurationSha256": {
          "$ref": "#/definitions/sha256"
        },
        "trustSha256": {
          "$ref": "#/definitions/sha256"
        },
        "observedStateSha256": {
          "$ref": "#/definitions/sha256"
        },
        "planSha256": {
          "$ref": "#/definitions/sha256"
        },
        "affectedServiceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/opaqueRef",
            "type": "string"
          }
        },
        "permittedEffects": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        },
        "mutationDomainSha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "validationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "validation",
        "bindingSha256"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "validation": {
          "$ref": "#/definitions/validation"
        },
        "bindingSha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "validationJobId",
        "validationClaimId",
        "receipt"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "validationJobId": {
          "$ref": "https://tokentimer.io/contracts/certops/signed-dispatch-payload.schema.json#/properties/jobId"
        },
        "validationClaimId": {
          "$ref": "https://tokentimer.io/contracts/certops/signed-dispatch-payload.schema.json#/properties/claimId"
        },
        "receipt": {
          "$ref": "#/definitions/validationReceipt"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payloadSha256",
        "intentSha256"
      ],
      "properties": {
        "payloadSha256": {
          "$ref": "#/definitions/sha256"
        },
        "intentSha256": {
          "$ref": "#/definitions/sha256"
        }
      },
      "description": "The controller signs both hashes from the native approval decision after rechecking its current authority. These hashes do not authorize a request outside its signed dispatch."
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "operationId",
        "mutationDomainSha256",
        "ownerClaimId"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "operationId": {
          "$ref": "#/definitions/sha256"
        },
        "mutationDomainSha256": {
          "$ref": "#/definitions/sha256"
        },
        "ownerClaimId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      }
    },
    "observationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "operationId",
        "mutationDomainSha256",
        "ownerJobId",
        "ownerClaimId",
        "validationJobId",
        "zoneRef",
        "destinationKind",
        "destinationRef"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "operationId": {
          "$ref": "#/definitions/sha256"
        },
        "mutationDomainSha256": {
          "$ref": "#/definitions/sha256"
        },
        "ownerJobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "ownerClaimId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "validationJobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "zoneRef": {
          "$ref": "#/definitions/opaqueRef"
        },
        "destinationKind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "destinationRef": {
          "$ref": "#/definitions/opaqueRef"
        }
      }
    },
    "historicalObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "observedStateSha256",
        "affectedServiceRefs"
      ],
      "properties": {
        "state": {
          "enum": [
            "observed",
            "inconclusive"
          ]
        },
        "observedStateSha256": {
          "anyOf": [
            {
              "$ref": "#/definitions/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "affectedServiceRefs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/opaqueRef",
            "type": "string"
          }
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "observed"
          }
        }
      },
      "then": {
        "properties": {
          "observedStateSha256": {
            "$ref": "#/definitions/sha256"
          }
        }
      }
    },
    "observationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "observation",
        "bindingSha256"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "observation": {
          "$ref": "#/definitions/historicalObservation"
        },
        "bindingSha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "executionOutcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "verifiedFingerprintSha256",
            "verifiedServiceRefs",
            "verificationSha256"
          ],
          "properties": {
            "state": {
              "const": "confirmed"
            },
            "verifiedFingerprintSha256": {
              "$ref": "#/definitions/sha256"
            },
            "verifiedServiceRefs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/opaqueRef",
                "type": "string"
              }
            },
            "verificationSha256": {
              "$ref": "#/definitions/sha256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "unknown"
            }
          }
        }
      ]
    },
    "executionReceipt": {
      "description": "Preview receipt binding the verified outcome to the durable intended-effect record and the signed owner claim.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "intendedEffectSha256",
        "outcome",
        "bindingSha256"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "intendedEffectSha256": {
          "$ref": "#/definitions/sha256"
        },
        "outcome": {
          "$ref": "#/definitions/executionOutcome"
        },
        "bindingSha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    }
  }
}
