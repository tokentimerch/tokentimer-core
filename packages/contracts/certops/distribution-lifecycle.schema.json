{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tokentimer.io/contracts/certops/distribution-lifecycle.schema.json",
  "title": "Public certificate distribution lifecycle policy",
  "definitions": {
    "alias": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "maxParallel",
        "authorizationExpiresAt",
        "verification",
        "alerts",
        "retention"
      ],
      "properties": {
        "mode": {
          "enum": [
            "manual",
            "approval_request",
            "preauthorized"
          ]
        },
        "maxParallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "authorizationExpiresAt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time",
              "maxLength": 40
            }
          ]
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "intervalSeconds",
            "maxBackoffSeconds",
            "staleJobSeconds",
            "failureThreshold"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "intervalSeconds": {
              "type": "integer",
              "minimum": 300,
              "maximum": 604800
            },
            "maxBackoffSeconds": {
              "type": "integer",
              "minimum": 300,
              "maximum": 604800
            },
            "staleJobSeconds": {
              "type": "integer",
              "minimum": 300,
              "maximum": 86400
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          }
        },
        "alerts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "offlineSeconds",
            "stuckSeconds",
            "convergenceSeconds",
            "expiryWarningDays",
            "repeatSeconds",
            "contactGroupIds"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "offlineSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 604800
            },
            "stuckSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 604800
            },
            "convergenceSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 604800
            },
            "expiryWarningDays": {
              "type": "integer",
              "minimum": 0,
              "maximum": 90
            },
            "repeatSeconds": {
              "type": "integer",
              "minimum": 3600,
              "maximum": 604800
            },
            "contactGroupIds": {
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              }
            }
          }
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimumSeconds",
            "minimumVersions",
            "rollbackSeconds",
            "cleanupEnabled",
            "reportOnly",
            "requiresApproval"
          ],
          "properties": {
            "minimumSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 315360000
            },
            "minimumVersions": {
              "type": "integer",
              "minimum": 2,
              "maximum": 1000
            },
            "rollbackSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 31536000
            },
            "cleanupEnabled": {
              "type": "boolean"
            },
            "reportOnly": {
              "type": "boolean"
            },
            "requiresApproval": {
              "const": true
            }
          }
        }
      }
    },
    "activationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "disruptive",
        "requiresApproval",
        "timezone",
        "windows",
        "blackouts",
        "validUntil",
        "emergency"
      ],
      "properties": {
        "method": {
          "enum": [
            "none",
            "reload",
            "rebind",
            "no-restart-refresh",
            "controlled-restart",
            "manual"
          ]
        },
        "disruptive": {
          "type": "boolean"
        },
        "requiresApproval": {
          "type": "boolean"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "windows": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "days",
              "start",
              "end"
            ],
            "properties": {
              "days": {
                "type": "array",
                "minItems": 1,
                "maxItems": 7,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                }
              },
              "start": {
                "type": "string",
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "end": {
                "type": "string",
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            }
          }
        },
        "blackouts": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "string",
                "format": "date-time",
                "maxLength": 40
              },
              "end": {
                "type": "string",
                "format": "date-time",
                "maxLength": 40
              }
            }
          }
        },
        "validUntil": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time",
              "maxLength": 40
            }
          ]
        },
        "emergency": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end",
                "reference"
              ],
              "properties": {
                "start": {
                  "type": "string",
                  "format": "date-time",
                  "maxLength": 40
                },
                "end": {
                  "type": "string",
                  "format": "date-time",
                  "maxLength": 40
                },
                "reference": {
                  "$ref": "#/definitions/alias"
                }
              }
            }
          ]
        }
      }
    },
    "policyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "expectedRevision"
      ],
      "properties": {
        "policy": {
          "$ref": "#/definitions/policy"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "activationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "expectedAuthorizationRevision"
      ],
      "properties": {
        "policy": {
          "$ref": "#/definitions/activationPolicy"
        },
        "expectedAuthorizationRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    }
  }
}
