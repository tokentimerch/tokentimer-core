      "output": "mcp-read-tools.schema.json#/definitions/tt_get_certificate_output",
      "route": "GET /api/v1/workspaces/:id/certops/certificate-identities/:identityId",
      "routeStatus": "existing-needs-operator-projection"
    },
    {
      "name": "tt_get_certificate_observations",
      "title": "Show where a certificate was observed and its deployment status",
      "scope": "mcp:certs:read",
      "minRole": "viewer",
      "contractStatus": "mvp",
      "annotations": { "readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false },
