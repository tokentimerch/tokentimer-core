    {
      "name": "tt_list_jobs",
      "title": "List jobs by status, operation or certificate",
      "scope": "mcp:jobs:read",
      "minRole": "viewer",
      "contractStatus": "mvp",
      "annotations": { "readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false },
      "input": "mcp-read-tools.schema.json#/definitions/tt_list_jobs_input",
      "output": "mcp-read-tools.schema.json#/definitions/tt_list_jobs_output",
