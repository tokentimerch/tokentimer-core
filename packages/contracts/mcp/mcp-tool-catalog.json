      "output": "mcp-read-tools.schema.json#/definitions/tt_get_certificate_observations_output",
      "route": "GET /api/v1/workspaces/:id/certops/certificate-identities/:identityId/observations",
      "routeStatus": "new"
    },
    {
      "name": "tt_get_agent_health",
      "title": "Show agent liveness and declared operations",
