  "tools": [
    {
      "name": "tt_whoami",
      "title": "Show the connection, workspace and effective role",
      "scope": "mcp:identity:read",
      "minRole": "viewer",
      "contractStatus": "mvp",
      "annotations": { "readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false },
      "input": "mcp-read-tools.schema.json#/definitions/tt_whoami_input",
      "output": "mcp-read-tools.schema.json#/definitions/tt_whoami_output",
      "route": "GET /api/v1/workspaces/:id/mcp/whoami",
      "routeStatus": "new"
    },
    {
      "name": "tt_list_certificates",
      "title": "List certificates by lifecycle, expiry or renewal-path state",
      "scope": "mcp:certs:read",
      "minRole": "viewer",
      "contractStatus": "mvp",
      "annotations": { "readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false },
      "input": "mcp-read-tools.schema.json#/definitions/tt_list_certificates_input",
      "output": "mcp-read-tools.schema.json#/definitions/tt_list_certificates_output",
      "route": "GET /api/v1/workspaces/:id/certops/certificate-identities",
      "routeStatus": "existing-needs-operator-projection"
    },
    {
      "name": "tt_get_certificate",
      "title": "Inspect one certificate identity",
      "scope": "mcp:certs:read",
      "minRole": "viewer",
      "contractStatus": "mvp",
