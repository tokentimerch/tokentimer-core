{
  "catalogVersion": 1,
  "status": "proposed",
  "description": "Tool catalog for the MCP operator interface proposed in ADR-0015. contractStatus: mvp = schemas finalized for the first read-only release (still subject to ADR acceptance); outline = tool named and scoped, schema not yet written; draft = schema exists but governing ADR decisions are open and it must not be treated as final. Annotations are advisory UX hints for clients and are never an authorization control. Routes are proposed backing REST routes; routeStatus tells whether the route exists today.",
  "mcpProtocol": {
    "version": "2026-07-28",
    "source": "https://modelcontextprotocol.io/specification/versioning",
    "verifiedOn": "2026-10-19",
    "sdkPin": "unpinned: set to an exact version before the read-only implementation starts",
    "clientCompatibility": "unproven: established by conformance tests, not by the existence of the specification"
  },
  "scopes": [
    { "name": "mcp:identity:read", "minRole": "viewer", "stage": "read-only" },
