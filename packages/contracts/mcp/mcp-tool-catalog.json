      "output": "mcp-read-tools.schema.json#/definitions/tt_get_agent_health_output",
      "route": "GET /api/v1/workspaces/:id/certops/agents",
      "routeStatus": "existing-needs-operator-projection"
    },
    {
      "name": "tt_get_job",
      "title": "Show one job's status, approval state and pending reason",
      "scope": "mcp:jobs:read",
      "minRole": "viewer",
      "contractStatus": "mvp",
      "annotations": { "readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false },
