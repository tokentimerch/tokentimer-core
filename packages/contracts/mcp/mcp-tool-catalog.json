{
  "catalogVersion": 1,
  "status": "proposed",
  "description": "Tool catalog for the MCP operator interface proposed in ADR-0015. contractStatus: mvp = schemas finalized for the first read-only release (still subject to ADR acceptance); outline = tool named and scoped, schema not yet written; draft = schema exists but governing ADR decisions are open and it must not be treated as final. Annotations are advisory UX hints for clients and are never an authorization control. Routes live in the operator namespace (/api/v1/operator/*), which accepts only an operator connection credential and takes the workspace from the connection, never from the path. routeStatus is implemented or planned. sessionRouteMinRole records the role the existing session route requires for the same data; a tool may never be looser than it.",
  "mcpProtocol": {
    "version": "2026-07-28",
    "source": "https://modelcontextprotocol.io/specification/versioning",
    "verifiedOn": "2026-10-19",
    "sdkPin": {
      "status": "proposed",
      "server": "@modelcontextprotocol/server@2.3.1",
      "conformanceClient": "@modelcontextprotocol/client@2.3.1",
      "checkedOn": "2026-10-19",
      "evidence": "The v1.x line (@modelcontextprotocol/sdk 1.32.1, npm latest) implements the specification only up to 2025-11-25 and its README says 2026-07-28 support is not planned for v1.x. The v2 packages export a modern-revision server with a stdio entry point; their dependency set and node floor (>=20) fit this repository's node range (>=22 <25).",
      "openQuestions": [
        "behavior toward clients that still use the 2025-11-25 handshake (the package ships a legacy path whose behavior is unverified here)",
        "exact transitive dependency set and license review (zod ^4, Apache-2.0) before adding it to the workspace"
      ]
    },
    "clientCompatibility": "unproven: established by conformance tests, not by the existence of the specification"
  },
  "scopes": [
    { "name": "mcp:identity:read", "minRole": "viewer", "stage": "read-only" },
    { "name": "mcp:certs:read", "minRole": "viewer", "stage": "read-only" },
