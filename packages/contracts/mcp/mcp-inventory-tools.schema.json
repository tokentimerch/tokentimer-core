    "tt_get_token_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record"
      ],
      "properties": {
        "record": {
          "$ref": "#/definitions/tokenRecord"
        }
      }
    },
    "inventoryRecordInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
