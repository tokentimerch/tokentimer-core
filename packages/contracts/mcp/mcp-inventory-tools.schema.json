{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tokentimer.io/contracts/mcp/mcp-inventory-tools.schema.json",
  "title": "MCP token inventory tools",
  "description": "Workspace-confined inventory metadata reads and explicitly authorized create-only imports. The caller normalizes irregular input into typed records; the server validates and previews an exact expiring batch before import. Existing records are kept. No secret values or provider credentials are accepted.",
  "definitions": {
    "tokenRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "category",
        "expiresAt",
        "location",
        "usedBy",
        "sections",
        "domains",
        "description",
        "provider",
        "sourceKind",
        "managedByAutoSync",
        "lastUsedAt",
        "importedAt"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "name": {
          "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/untrustedText"
        },
        "type": {
          "type": "string",
          "enum": [
            "ssl_cert",
            "tls_cert",
            "code_signing",
            "client_cert",
            "api_key",
            "secret",
            "password",
            "encryption_key",
            "ssh_key",
            "software_license",
            "service_subscription",
            "domain_registration",
            "other",
            "document",
            "membership"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "cert",
            "key_secret",
            "license",
            "general"
          ]
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        "location": {
          "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/nullableUntrustedText"
        },
        "usedBy": {
          "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/nullableUntrustedText"
        },
        "sections": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/untrustedText"
          }
        },
        "domains": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/untrustedText"
          }
        },
        "description": {
          "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/nullableUntrustedText"
        },
        "provider": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          ]
        },
        "sourceKind": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          ]
        },
        "managedByAutoSync": {
          "type": "boolean"
        },
        "lastUsedAt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/timestamp"
            }
          ]
        },
        "importedAt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/timestamp"
            }
          ]
        }
      }
    },
    "tt_list_tokens_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "sourceKind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "ssl_cert",
            "tls_cert",
            "code_signing",
            "client_cert",
            "api_key",
            "secret",
            "password",
            "encryption_key",
            "ssh_key",
            "software_license",
            "service_subscription",
            "domain_registration",
            "other",
