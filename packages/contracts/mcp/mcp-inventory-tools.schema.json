        "locationContains": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expiresBefore": {
          "type": "string",
          "format": "date"
        },
        "limit": {
          "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/limit"
        },
        "cursor": {
          "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/cursor"
        }
      }
    },
    "tt_list_tokens_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "completeness"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/definitions/tokenRecord"
          }
        },
        "completeness": {
          "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/completeness"
