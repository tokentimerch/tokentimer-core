{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tokentimer.io/contracts/mcp/mcp-read-tools.schema.json",
  "title": "MCP read-only tool contracts (first read-only release)",
  "description": "Input and output shapes for the read-only tools in the first MCP release described by ADR-0015. Each tool has a <name>_input and <name>_output definition. Outputs are what the REST API returns to an operator connection after the operator-safe projection; the MCP adapter returns them as structuredContent unchanged.",
  "$comment": "Status: proposed with ADR-0015. Closed objects only. Deliberately absent from every output: job claimId and lease data, signed payloads and nonces, dispatch secrets, key_reference and certificate/deployment filesystem paths, notes and other free-form operator text, PEM bodies, and any credential-like value. Reason codes are format-constrained here; the enumerations are frozen by the field-to-source inventory that precedes the read-only implementation, which composes renewalPathHealth, jobPendingReason and explainAgentJobEligibility.",
  "definitions": {
    "uuid": {
      "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/uuid"
    },
    "fingerprintSha256": {
      "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/fingerprintSha256"
    },
    "timestamp": {
      "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/timestamp"
    },
    "nullableTimestamp": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/timestamp"
        }
      ]
    },
    "snakeCode": {
      "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/snakeCode"
    },
    "workspaceRole": {
      "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/workspaceRole"
    },
    "scope": {
      "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/scope"
    },
    "untrustedText": {
      "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/untrustedText"
    },
    "nullableUntrustedText": {
      "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/nullableUntrustedText"
    },
    "limit": {
      "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/limit"
    },
    "cursor": {
      "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/cursor"
    },
    "completeness": {
      "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/completeness"
    },
    "lifecycleStatus": {
      "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/lifecycleStatus"
    },
    "displayStatus": {
      "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/displayStatus"
    },
    "presenceState": {
      "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/presenceState"
    },
    "capabilityString": {
      "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/capabilityString"
    },
    "renewalPathState": {
      "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/renewalPathState"
    },
    "jobStatus": {
      "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/jobStatus"
    },
    "jobOperation": {
      "$ref": "https://tokentimer.io/contracts/mcp/mcp-common.schema.json#/definitions/jobOperation"
    },
    "tt_whoami_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "tt_whoami_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "workspace",
        "role",
        "connection",
        "certops"
      ],
      "properties": {
        "contractVersion": {
          "type": "integer",
          "const": 1
        },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/uuid"
            },
            "name": {
              "$ref": "#/definitions/untrustedText"
            }
          }
        },
        "role": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current",
            "ceiling",
            "effective"
          ],
          "properties": {
            "current": {
              "$ref": "#/definitions/workspaceRole"
            },
            "ceiling": {
              "$ref": "#/definitions/workspaceRole"
            },
            "effective": {
              "$ref": "#/definitions/workspaceRole"
            }
          }
        },
        "connection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "scopes",
            "expiresAt"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/uuid"
            },
            "scopes": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 16,
              "items": {
                "$ref": "#/definitions/scope"
              }
            },
            "expiresAt": {
              "$ref": "#/definitions/timestamp"
            }
          }
        },
        "certops": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "paused",
            "approvalRequiredAlways",
            "mcpWritesEnabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "paused": {
              "type": "boolean"
            },
            "approvalRequiredAlways": {
              "type": "boolean"
            },
            "mcpWritesEnabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "certificateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "fingerprintSha256",
        "commonName",
        "issuer",
        "notAfter",
        "daysUntilExpiry",
        "displayStatus",
        "lifecycleStatus",
        "renewalPathState",
        "stillObserved"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/uuid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "identity",
            "provisional"
          ]
        },
        "fingerprintSha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/fingerprintSha256"
            }
          ]
        },
        "commonName": {
          "$ref": "#/definitions/nullableUntrustedText"
        },
        "issuer": {
          "$ref": "#/definitions/nullableUntrustedText"
        },
        "notAfter": {
          "$ref": "#/definitions/nullableTimestamp"
        },
        "daysUntilExpiry": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer"
            }
          ]
        },
        "displayStatus": {
          "$ref": "#/definitions/displayStatus"
        },
        "lifecycleStatus": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/lifecycleStatus"
            }
          ]
        },
        "renewalPathState": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/renewalPathState"
            }
          ]
        },
        "stillObserved": {
          "type": "boolean"
        }
      }
    },
    "tt_list_certificates_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/definitions/displayStatus"
        },
        "includeRetired": {
          "type": "boolean",
          "default": false
        },
        "expiresWithinDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "expiresBefore": {
          "$ref": "#/definitions/timestamp"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "limit": {
          "$ref": "#/definitions/limit"
        },
        "cursor": {
          "$ref": "#/definitions/cursor"
        }
      },
      "not": {
        "required": [
          "expiresWithinDays",
          "expiresBefore"
        ]
      }
    },
    "tt_list_certificates_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "completeness"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/definitions/certificateSummary"
          }
        },
        "completeness": {
          "$ref": "#/definitions/completeness"
        }
      }
    },
    "tt_get_certificate_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identityId": {
          "$ref": "#/definitions/uuid"
        },
        "fingerprintSha256": {
          "$ref": "#/definitions/fingerprintSha256"
        }
      },
      "oneOf": [
        {
          "required": [
            "identityId"
          ]
        },
        {
          "required": [
            "fingerprintSha256"
          ]
        }
      ]
    },
    "tt_get_certificate_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certificate"
      ],
      "properties": {
        "certificate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "details",
            "lifecycle",
            "managementPeriods",
            "managementPeriodsTruncated",
            "renewal",
            "observation"
          ],
          "properties": {
            "summary": {
              "$ref": "#/definitions/certificateSummary"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "notBefore",
                "sans",
                "sansTruncated"
              ],
              "properties": {
                "notBefore": {
                  "$ref": "#/definitions/nullableTimestamp"
                },
                "sans": {
                  "type": "array",
                  "maxItems": 25,
                  "items": {
                    "$ref": "#/definitions/untrustedText"
                  }
                },
                "sansTruncated": {
                  "type": "boolean"
                }
              }
            },
            "lifecycle": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "$ref": "#/definitions/lifecycleStatus"
                }
              }
            },
            "managementPeriods": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "periodId",
                  "sourceKind",
                  "startedAt",
                  "endedAt",
                  "endedReason"
                ],
                "properties": {
                  "periodId": {
                    "$ref": "#/definitions/uuid"
                  },
                  "sourceKind": {
                    "$ref": "#/definitions/snakeCode"
                  },
                  "startedAt": {
                    "$ref": "#/definitions/timestamp"
                  },
                  "endedAt": {
                    "$ref": "#/definitions/nullableTimestamp"
                  },
                  "endedReason": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "#/definitions/snakeCode"
                      }
                    ]
                  }
                }
              }
            },
            "managementPeriodsTruncated": {
              "type": "boolean"
            },
            "renewal": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pathState",
                "pathReason",
                "profileId",
                "workspacePaused"
              ],
              "properties": {
                "pathState": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/definitions/renewalPathState"
                    }
                  ]
                },
                "pathReason": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/definitions/snakeCode"
                    }
                  ]
                },
                "profileId": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/definitions/uuid"
                    }
                  ]
                },
                "workspacePaused": {
                  "type": "boolean"
                }
              }
            },
            "observation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lastObservedAt",
                "locationCount",
                "visibilityUnknown"
              ],
              "properties": {
                "lastObservedAt": {
                  "$ref": "#/definitions/nullableTimestamp"
                },
                "locationCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "visibilityUnknown": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "tt_get_certificate_observations_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityId"
      ],
      "properties": {
        "identityId": {
          "$ref": "#/definitions/uuid"
        },
        "limit": {
          "$ref": "#/definitions/limit"
        },
        "cursor": {
          "$ref": "#/definitions/cursor"
        }
      }
    },
    "tt_get_certificate_observations_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityId",
        "visibilityUnknown",
        "items",
        "completeness"
      ],
      "properties": {
        "identityId": {
          "$ref": "#/definitions/uuid"
        },
        "visibilityUnknown": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "locationKind",
              "presenceState",
              "evidenceKind",
              "observedAt",
              "monitoringEnded",
              "observationReason",
              "previousObservationCount"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/uuid"
              },
              "source": {
                "$ref": "#/definitions/snakeCode"
              },
              "locationKind": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/definitions/snakeCode"
                  }
                ]
              },
              "presenceState": {
                "$ref": "#/definitions/presenceState"
              },
              "evidenceKind": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "service_binding",
                      "stored_copy",
                      "unknown"
                    ]
                  }
                ]
              },
              "observedAt": {
                "$ref": "#/definitions/nullableTimestamp"
              },
              "monitoringEnded": {
                "type": "boolean"
              },
              "observationReason": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/definitions/snakeCode"
                  }
                ]
              },
              "previousObservationCount": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "completeness": {
          "$ref": "#/definitions/completeness"
        }
      }
    },
    "tt_get_agent_health_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "$ref": "#/definitions/limit"
        },
        "cursor": {
          "$ref": "#/definitions/cursor"
        }
      }
    },
    "tt_get_agent_health_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "completeness"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "hostname",
              "platform",
              "status",
              "liveness",
              "agentKind",
              "lastSeenAt",
              "agentVersion",
              "protocolVersion",
              "compatibilityState",
              "clockDriftState",
              "supportedOperations",
              "declaredCapabilities"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/uuid"
              },
              "hostname": {
                "$ref": "#/definitions/nullableUntrustedText"
              },
              "platform": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "linux",
                      "darwin",
                      "win32"
                    ]
                  }
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "active",
                  "offline",
                  "retired"
                ]
              },
              "liveness": {
                "type": "string",
                "enum": [
                  "live",
                  "stale",
                  "retired"
                ]
              },
              "agentKind": {
                "type": "string",
                "enum": [
                  "normal",
                  "diagnostic"
                ]
              },
              "lastSeenAt": {
                "$ref": "#/definitions/nullableTimestamp"
              },
              "agentVersion": {
                "type": "string",
                "maxLength": 32
              },
              "protocolVersion": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "compatibilityState": {
                "$ref": "#/definitions/snakeCode"
              },
              "clockDriftState": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/definitions/snakeCode"
                  }
                ]
              },
              "supportedOperations": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "$ref": "#/definitions/jobOperation"
                }
              },
              "declaredCapabilities": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "$ref": "#/definitions/capabilityString"
                }
              }
            }
          }
        },
        "completeness": {
          "$ref": "#/definitions/completeness"
        }
      }
    },
    "jobSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation",
        "status",
        "subjectType",
        "subjectId",
        "createdAt",
        "startedAt",
        "completedAt",
        "requestedByKind",
        "needsOperatorReconciliation"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/uuid"
        },
        "operation": {
          "$ref": "#/definitions/jobOperation"
        },
        "status": {
          "$ref": "#/definitions/jobStatus"
        },
        "subjectType": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/snakeCode"
            }
          ]
        },
        "subjectId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/uuid"
            }
          ]
        },
        "createdAt": {
          "$ref": "#/definitions/timestamp"
        },
        "startedAt": {
          "$ref": "#/definitions/nullableTimestamp"
        },
        "completedAt": {
          "$ref": "#/definitions/nullableTimestamp"
        },
        "requestedByKind": {
          "type": "string",
          "enum": [
            "user",
            "api_token",
            "operator_connection",
            "system"
          ]
        },
        "needsOperatorReconciliation": {
          "type": "boolean"
        }
      }
    },
    "tt_get_job_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId"
      ],
      "properties": {
        "jobId": {
          "$ref": "#/definitions/uuid"
        }
      }
    },
    "tt_get_job_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job"
      ],
      "properties": {
        "job": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "updatedAt",
            "attemptCount",
            "approval",
            "pendingReason",
            "errorCode"
          ],
          "properties": {
            "summary": {
              "$ref": "#/definitions/jobSummary"
            },
            "updatedAt": {
              "$ref": "#/definitions/nullableTimestamp"
            },
            "attemptCount": {
              "type": "integer",
              "minimum": 0
            },
            "errorCode": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/definitions/snakeCode"
                }
              ]
            },
            "approval": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "required",
                "state",
                "decidedAt"
              ],
              "properties": {
                "required": {
                  "type": "boolean"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "not_required",
                    "pending",
                    "approved",
                    "rejected"
                  ]
                },
                "decidedAt": {
                  "$ref": "#/definitions/nullableTimestamp"
                }
              }
            },
            "pendingReason": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "$ref": "#/definitions/snakeCode"
                    },
                    "message": {
                      "type": "string",
                      "maxLength": 300
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "tt_list_jobs_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/definitions/jobStatus"
        },
        "operation": {
          "$ref": "#/definitions/jobOperation"
        },
        "subjectId": {
          "$ref": "#/definitions/uuid"
        },
        "createdSince": {
          "type": "string",
          "enum": [
            "24h",
            "7d",
            "30d"
          ]
        },
        "limit": {
          "$ref": "#/definitions/limit"
        },
        "cursor": {
          "$ref": "#/definitions/cursor"
        }
      }
    },
    "tt_list_jobs_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "completeness"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/definitions/jobSummary"
          }
        },
        "completeness": {
          "$ref": "#/definitions/completeness"
        }
      }
    },
    "tt_explain_certificate_state_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityId"
      ],
      "properties": {
        "identityId": {
          "$ref": "#/definitions/uuid"
        }
      }
    },
    "tt_explain_certificate_state_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityId",
        "evaluatedAt",
        "lifecycleStatus",
        "overall",
        "reasons",
        "unknownAreas"
      ],
      "properties": {
        "identityId": {
          "$ref": "#/definitions/uuid"
        },
