# TokenTimer Core - local development environment
# Copy to .env in the repository root: cp .env.example .env
#
# Full production and Compose reference:
# deploy/compose/.env.example

NODE_ENV=development
SESSION_SECRET=dev_session_secret_change_in_production

DB_HOST=localhost
DB_PORT=5432
DB_NAME=tokentimer
DB_USER=tokentimer
DB_PASSWORD=password

ADMIN_EMAIL=admin@localhost.local
ADMIN_PASSWORD=AdminPassword123!
ADMIN_NAME=Administrator

APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# CertOps rollout flag. Default is false when unset.
CERTOPS_ENABLED=false

# Assistant (MCP) operator interface. Both are off when unset. The first enables the
# /api/v1/operator namespace and connection setup (read tools). The second also allows
# assistant renewal requests; it has no effect without the first, and each workspace
# admin must still switch requests on for that workspace.
MCP_OPERATOR_INTERFACE_ENABLED=false
MCP_OPERATOR_WRITES_ENABLED=false

# Optional: worker cron schedules (defaults match Kubernetes Helm).
# Cron mode is default; *_INTERVAL_MS vars apply only when *_CRON=interval.
# Worker Compose services set TZ from docker-compose.yml (default UTC).
# TZ=UTC
# WORKER_DISCOVERY_CRON="*/5 * * * *"
# WORKER_DELIVERY_CRON="1/5 * * * *"
# WORKER_AUTO_SYNC_CRON="*/1 * * * *"
# WORKER_ENDPOINT_CHECK_CRON="*/1 * * * *"
# WORKER_WEEKLY_DIGEST_CRON="0 9 * * 1"
# WORKER_CERTOPS_CRON="*/1 * * * *"
# WORKER_RUN_ON_START=false
# WORKER_EXIT_ON_ERROR=false

# CertOps stale-agent sweep: how long an 'active' agent may go without a
# heartbeat before worker-certops marks it 'offline'. Default: 600000 (10m).
# CERTOPS_AGENT_OFFLINE_AFTER_MS=600000

# Optional System Settings override; leave empty to use saved settings.
AUTO_SYNC_METRICS_ENABLED=
# Global label selection; requires AUTO_SYNC_METRICS_ENABLED=true/false. Empty uses saved labels; none selects no optional labels.
# configuration_name: saved integration name; monitoring_group: your monitoring category.
# kind: asset type; asset_name: imported token/key/secret name (never its value).
# project: source project/repository name or path; group: source group name or path (when supplied).
# Labels add series to both detailed metrics; combinations can greatly increase cardinality and expose metadata.
AUTO_SYNC_METRICS_LABELS=
# Optional global monitoring group; empty uses the saved override or connection value.
AUTO_SYNC_METRICS_MONITORING_GROUP=
# Extra labels: asset_name, project, group; none disables them.
# Empty uses saved UI choices (off by default); a list restricts the available asset labels.
# Selected labels appear on auto_sync_items_created_detailed_total and
# auto_sync_last_creation_timestamp_seconds; aggregate counters stay unchanged.
# Each distinct label combination creates a series in both metrics; combining labels can greatly increase cardinality and expose asset metadata.
AUTO_SYNC_METRICS_EXTRA_LABELS=
