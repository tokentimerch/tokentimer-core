{
  "agentId": "REPLACE_WITH_CONSUMER_WIRE_ID",
  "execution": { "enabled": true, "dryRun": false, "keysDir": "/var/lib/tokentimer-agent/keys" },
  "policy": {
    "allowedTargetSelectors": ["33333333-3333-4333-8333-333333333333"],
    "allowedPaths": ["/etc/nginx/tokentimer", "/var/lib/tokentimer-agent"],
    "allowedCommands": {
      "nginx-validate": { "argv": ["/usr/sbin/nginx", "-t"] },
      "nginx-reload": { "argv": ["/usr/sbin/nginx", "-s", "reload"] }
    }
  },
  "materialStores": {
    "customer": {
      "address": "https://vault.customer.example:8200",
      "mount": "secret",
      "tokenFile": "/run/tokentimer-vault/consumer-token",
      "caFile": "/etc/tokentimer-agent/vault-ca.pem",
      "timeoutMs": 10000,
      "groups": {
        "22222222-2222-4222-8222-222222222222": {
          "workspaceId": "11111111-1111-4111-8111-111111111111",
          "prefix": "tokentimer/11111111-1111-4111-8111-111111111111/22222222-2222-4222-8222-222222222222",
          "sans": ["*.example.com", "example.com"],
          "keyAlgorithm": "ec"
        }
      }
    }
  },
  "materialBindings": {
    "33333333-3333-4333-8333-333333333333": {
      "workspaceId": "11111111-1111-4111-8111-111111111111",
      "groupId": "22222222-2222-4222-8222-222222222222",
      "agentId": "REPLACE_WITH_CONSUMER_WIRE_ID",
      "materialStoreRef": "customer",
      "deploymentProfileRef": "nginx-public",
      "profileRevision": 1,
      "authorizationRevision": 1,
      "verificationPolicy": "trust",
      "reloadService": "nginx",
      "reloadCommandRefs": { "validate": "nginx-validate", "reload": "nginx-reload" },
      "target": { "type": "endpoint", "reference": "nginx-public", "certPath": "/etc/nginx/tokentimer/fullchain.pem", "keyPath": "/etc/nginx/tokentimer/privkey.pem" },
      "probes": [{ "dialAddress": "127.0.0.1", "port": 443, "sni": "www.example.com" }]
    }
  }
}
