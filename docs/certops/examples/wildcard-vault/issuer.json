{
  "agentId": "REPLACE_WITH_ISSUER_WIRE_ID",
  "execution": { "enabled": true, "dryRun": false, "keysDir": "/var/lib/tokentimer-agent/keys" },
  "policy": {
    "allowedTargetSelectors": ["*.example.com"],
    "allowedPaths": ["/var/lib/tokentimer-agent"],
    "allowedCaEndpoints": ["https://acme-v02.api.letsencrypt.org/directory"],
    "allowedDnsZones": ["example.com"],
    "allowedDnsProviders": ["cloudflare"],
    "allowedCommands": { "certbot": { "argv": ["/usr/bin/certbot"] } }
  },
  "dnsProviders": { "cloudflare": { "credentialsFile": "/etc/tokentimer-agent/cloudflare.json" }, "zoneProviderMap": { "example.com": "cloudflare" } },
  "materialStores": {
    "customer": {
      "address": "https://vault.customer.example:8200",
      "mount": "secret",
      "tokenFile": "/run/tokentimer-vault/issuer-token",
      "caFile": "/etc/tokentimer-agent/vault-ca.pem",
      "timeoutMs": 10000,
      "groups": {
        "22222222-2222-4222-8222-222222222222": {
          "workspaceId": "11111111-1111-4111-8111-111111111111",
          "prefix": "tokentimer/11111111-1111-4111-8111-111111111111/22222222-2222-4222-8222-222222222222",
          "sans": ["*.example.com", "example.com"],
          "keyAlgorithm": "ec",
          "issuerAgentId": "REPLACE_WITH_ISSUER_WIRE_ID",
          "issuanceProfileRef": "wildcard",
          "profileRevision": 1,
          "caEndpoint": "https://acme-v02.api.letsencrypt.org/directory",
          "dnsProvider": "cloudflare",
          "dnsZone": "example.com"
        }
      }
    }
  }
}
